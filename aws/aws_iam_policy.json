{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": "arn:aws:s3:::aditya-project-bucket/snowflake_project/raw/*"
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::aditya-project-bucket",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "snowflake_project/raw/*"
                    ]
                }
            }
        }
    ]
}
